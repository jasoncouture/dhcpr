@inherits LayoutComponentBase
@using System.Reflection
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject NavigationManager Navigation
@inject IOptions<AuthenticationConfiguration> Authentication

<div class="page @(_navToggled ? "nav-toggled" : null)">
    <header class="topbar">
        <button type="button"
                class="hamburger"
                aria-label="Toggle navigation"
                aria-controls="app-sidebar"
                @onclick="ToggleNav">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <a href="/" class="brand">dhcpr</a>
        <AuthorizeView>
            <span class="user">@context.User.Identity?.Name</span>
        </AuthorizeView>
    </header>
    <div class="shell">
        <aside id="app-sidebar" class="sidebar">
            <nav>
                <AuthorizeView Policy="@OidcAuthenticationExtensions.DnsViewerPolicy">
                    <NavLink href="/" Match="NavLinkMatch.All" @onclick="ResetNav">live queries</NavLink>
                </AuthorizeView>
                <AuthorizeView Policy="@OidcAuthenticationExtensions.DnsAdminPolicy">
                    <a class="nav-external" href="/orleans" data-enhance-nav="false">
                        orleans
                        <svg class="nav-external-icon" viewBox="0 0 16 16" aria-hidden="true">
                            <path fill="currentColor" d="M6.5 3.5h-3A1.5 1.5 0 0 0 2 5v7.5A1.5 1.5 0 0 0 3.5 14H11a1.5 1.5 0 0 0 1.5-1.5v-3h-1.25v3a.25.25 0 0 1-.25.25H3.5a.25.25 0 0 1-.25-.25V5a.25.25 0 0 1 .25-.25h3zm3.75 0H14v3.75h-1.25V5.634L7.442 11.19l-.884-.884 5.308-5.557H10.25z"/>
                        </svg>
                    </a>
                    <span class="nav-group">settings</span>
                    <NavLink href="/settings/routes" @onclick="ResetNav">routes</NavLink>
                    <NavLink href="/settings/records" @onclick="ResetNav">records</NavLink>
                    <NavLink href="/settings/blackhole" @onclick="ResetNav">blackhole</NavLink>
                    <NavLink href="/settings/dnssec" @onclick="ResetNav">dnssec</NavLink>
                    <NavLink href="/settings/health" @onclick="ResetNav">health</NavLink>
                    <NavLink href="/settings/dynamic-dns" @onclick="ResetNav">dynamic dns</NavLink>
                </AuthorizeView>
            </nav>
            @if (Authentication.Value.Enabled)
            {
                <a class="logout"
                   href="@OidcAuthenticationExtensions.LogoutPath"
                   data-enhance-nav="false">sign out</a>
            }
        </aside>
        <button type="button"
                class="nav-backdrop"
                tabindex="-1"
                aria-hidden="true"
                @onclick="ResetNav"></button>
        <main>
            @Body
        </main>
    </div>
    <footer class="footer">@_informationalVersion</footer>
</div>

@code {
    private static readonly string _informationalVersion =
        typeof(Program).Assembly
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()
            ?.InformationalVersion
        ?? "unknown";

    private bool _navToggled;

    protected override void OnInitialized()
        => Navigation.LocationChanged += OnLocationChanged;

    private void ToggleNav() => _navToggled = !_navToggled;

    private void ResetNav() => _navToggled = false;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (!_navToggled)
            return;

        _navToggled = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => Navigation.LocationChanged -= OnLocationChanged;
}
