@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject NavigationManager Navigation

<div class="page @(_navToggled ? "nav-toggled" : null)">
    <header class="topbar">
        <button type="button"
                class="hamburger"
                aria-label="Toggle navigation"
                aria-controls="app-sidebar"
                @onclick="ToggleNav">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <a href="/" class="brand">dhcpr</a>
        <AuthorizeView>
            <span class="user">@context.User.Identity?.Name</span>
        </AuthorizeView>
    </header>
    <div class="shell">
        <aside id="app-sidebar" class="sidebar">
            <nav>
                <AuthorizeView Policy="@OidcAuthenticationExtensions.DnsViewerPolicy">
                    <NavLink href="/" Match="NavLinkMatch.All" @onclick="ResetNav">live queries</NavLink>
                </AuthorizeView>
                <AuthorizeView Policy="@OidcAuthenticationExtensions.DnsAdminPolicy">
                    <NavLink href="/settings" @onclick="ResetNav">settings</NavLink>
                </AuthorizeView>
            </nav>
            <AuthorizeView>
                <a class="logout"
                   href="@OidcAuthenticationExtensions.LogoutPath"
                   data-enhance-nav="false">logout</a>
            </AuthorizeView>
        </aside>
        <button type="button"
                class="nav-backdrop"
                tabindex="-1"
                aria-hidden="true"
                @onclick="ResetNav"></button>
        <main>
            @Body
        </main>
    </div>
</div>

@code {
    private bool _navToggled;

    protected override void OnInitialized()
        => Navigation.LocationChanged += OnLocationChanged;

    private void ToggleNav() => _navToggled = !_navToggled;

    private void ResetNav() => _navToggled = false;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (!_navToggled)
            return;

        _navToggled = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => Navigation.LocationChanged -= OnLocationChanged;
}
