@page "/"
@layout LandingLayout
@attribute [AllowAnonymous]

<PageTitle>DNS</PageTitle>

<h1>A no-log DNS server, focused on privacy.</h1>
<p class="lead">
    No logs, no analytics, no tracking. Pure DNS. Period.
</p>

<h2>Public resolvers</h2>
<p class="lead">
    We host public DNS resolvers, free for anyone to use. You can use them directly, or configure your own DNS server to use them.
    We speak classic DNS, DNS-over-TLS, and DNS-over-HTTPS.
</p>
