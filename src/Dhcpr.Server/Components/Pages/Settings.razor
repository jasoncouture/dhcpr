@page "/settings"
@rendermode InteractiveServer
@attribute [Authorize(Roles = ApplicationRoles.DnsAdmin)]
@inject IRuntimeSettingsStore Store

<div class="settings">
    <h1>Settings</h1>

    @if (_error is not null)
    {
        <p class="form-error">@_error</p>
    }
    @if (_saved)
    {
        <p class="form-saved">Saved.</p>
    }

    <section>
        <h2>Routes</h2>
        @foreach (var route in _routes)
        {
            <div class="card">
                <label>
                    Suffix
                    <input @bind="route.Suffix" />
                </label>
                <label>
                    Upstreams (one host:port per line)
                    <textarea rows="3" @bind="route.Upstreams"></textarea>
                </label>
                <label>
                    Clients (CIDR or IP, one per line; empty = any)
                    <textarea rows="4" @bind="route.Clients"></textarea>
                </label>
                <button type="button" class="danger" @onclick="() => _routes.Remove(route)">Remove</button>
            </div>
        }
        <button type="button" @onclick="AddRoute">Add route</button>
    </section>

    <section>
        <h2>Blackhole domains</h2>
        <label>
            One suffix per line
            <textarea rows="6" @bind="_blackhole"></textarea>
        </label>
    </section>

    <section>
        <h2>DNSSEC</h2>
        <label class="checkbox">
            <input type="checkbox" @bind="_dnssecEnabled" />
            Enabled
        </label>
        <label>
            Allowed algorithms (comma-separated bytes; empty = defaults)
            <input @bind="_allowedAlgorithms" />
        </label>
        <label>
            Denied algorithms (comma-separated bytes)
            <input @bind="_deniedAlgorithms" />
        </label>
    </section>

    <section>
        <h2>Health check</h2>
        <label class="checkbox">
            <input type="checkbox" @bind="_healthEnabled" />
            Enabled
        </label>
        <label>
            Domains (one per line)
            <textarea rows="4" @bind="_healthDomains"></textarea>
        </label>
        <label>
            Timeout seconds
            <input type="number" min="1" max="120" @bind="_healthTimeout" />
        </label>
    </section>

    <section>
        <h2>Dynamic DNS</h2>
        <label class="checkbox">
            <input type="checkbox" @bind="_dynEnabled" />
            Enabled
        </label>
        <label>
            Username
            <input @bind="_dynUsername" />
        </label>
        <label>
            Password (leave blank to keep current)
            <input type="password" @bind="_dynPassword" autocomplete="new-password" />
        </label>
        <label>
            TTL seconds
            <input type="number" min="1" max="86400" @bind="_dynTtl" />
        </label>
        <label class="checkbox">
            <input type="checkbox" @bind="_dynTrustForwardedFor" />
            Trust X-Forwarded-For
        </label>
    </section>

    <button type="button" class="primary" @onclick="SaveAsync" disabled="@_saving">Save</button>
</div>
