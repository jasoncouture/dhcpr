        "example.com",
        "cloudflare.com"
      ]
    },
    "Dnssec": {
      "Enabled": true,
      "AllowedAlgorithms": [],
      "DeniedAlgorithms": []
    },
    "DOH": {
      "MaxRequestBytes": 65535
    },
    "RootServers": {
