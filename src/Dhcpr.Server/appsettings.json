{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "DataPath": "./data",
  "DynamicDns": {
    "Enabled": true,
    "Username": "dyndns",
    "Password": "change-me",
    "TtlSeconds": 60,
    "TrustForwardedFor": false
  },
