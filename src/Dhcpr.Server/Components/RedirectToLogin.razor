@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = string.IsNullOrEmpty(relative)
            ? OidcAuthenticationExtensions.HomePath
            : OidcAuthenticationExtensions.UiPrefix + "/" + relative.TrimStart('/');
        Navigation.NavigateTo(
            $"{OidcAuthenticationExtensions.LoginPath}?returnUrl={Uri.EscapeDataString(path)}",
            forceLoad: true);
    }
}
