@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ILiveQueryStore Store

<div class="live-queries">
    <div class="toolbar">
        <span class="count">@VisibleCount shown</span>
        <label>
            <input type="checkbox" @bind="_paused" @bind:after="OnPauseChanged" />
            Pause
        </label>
        <label>
            <input type="checkbox" @bind="_hideBlackhole" @bind:after="StateHasChanged" />
            Hide blackhole
        </label>
    </div>

    <table class="query-table">
        <thead>
        <tr>
            <th>Time</th>
            <th>Cache</th>
            <th>Client</th>
            <th>Type</th>
            <th>Name</th>
            <th>RCODE</th>
            <th>Via</th>
            <th>Answers</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in VisibleRows())
        {
            <tr class="@(row.ResponseCode is DomainResponseCode.NoError ? null : "error")">
                <td>@row.Timestamp.ToString("HH:mm:ss.fff")</td>
                <td>@(row.CacheHit ? "HIT" : "MISS")</td>
                <td>@(row.Client?.ToString() ?? "—")</td>
                <td>@row.Type</td>
                <td>@row.Name</td>
                <td>@row.ResponseCode</td>
                <td>@row.Middleware</td>
                <td>@(string.IsNullOrEmpty(row.Answers) ? "—" : row.Answers)</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private const string BlackholeMiddleware = "Blackhole";

    private readonly List<DnsQueryEvent> _rows = new(LiveQueryStore.SnapshotCapacity);
    private IDisposable? _subscription;
    private CancellationTokenSource? _cts;
    private Task? _readLoop;
    private bool _paused;
    private bool _hideBlackhole;

    private int VisibleCount =>
        _hideBlackhole
            ? _rows.Count(static r => !IsLoopbackClient(r) && r.Middleware != BlackholeMiddleware)
            : _rows.Count(static r => !IsLoopbackClient(r));

    private IEnumerable<DnsQueryEvent> VisibleRows()
    {
        var rows = _rows.Where(static r => !IsLoopbackClient(r));
        if (!_hideBlackhole)
            return rows;

        return rows.Where(static r => r.Middleware != BlackholeMiddleware);
    }

    private static bool IsLoopbackClient(DnsQueryEvent evt) =>
        evt.Client?.Address is { } address && IPAddress.IsLoopback(address);

    protected override void OnInitialized()
    {
        foreach (var evt in Store.GetSnapshot())
            _rows.Add(evt);

        var (reader, subscription) = Store.Subscribe();
        _subscription = subscription;
        _cts = new CancellationTokenSource();
        _readLoop = ReadLoopAsync(reader, _cts.Token);
    }

    private async Task ReadLoopAsync(ChannelReader<DnsQueryEvent> reader, CancellationToken cancellationToken)
    {
        try
        {
            await foreach (var evt in reader.ReadAllAsync(cancellationToken))
            {
                // Always retain events; pause only freezes the render so unpausing shows everything.
                await InvokeAsync(() =>
                {
                    _rows.Insert(0, evt);
                    while (_rows.Count > LiveQueryStore.SnapshotCapacity)
                        _rows.RemoveAt(_rows.Count - 1);
                    if (!_paused)
                        StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnPauseChanged()
    {
        if (!_paused)
            StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
        }

        _subscription?.Dispose();

        if (_readLoop is not null)
        {
            try
            {
                await _readLoop;
            }
            catch (OperationCanceledException)
            {
            }
        }
    }
}
