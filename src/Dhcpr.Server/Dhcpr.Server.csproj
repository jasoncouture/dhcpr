<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.Extensions.Configuration.Binder.SourceGeneration</InterceptorsNamespaces>
        <!-- Force Blazor JS static assets even when restore runs before .razor files exist (Docker layer cache). -->
        <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
        <ThreadPoolMinThreads>64</ThreadPoolMinThreads>
        <ThreadPoolMaxThreads>1024</ThreadPoolMaxThreads>
        <TieredPGO>true</TieredPGO>
        <NoWarn>$(NoWarn);SYSLIB1100;SYSLIB1101</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Dhcpr.Dhcp.Core\Dhcpr.Dhcp.Core.csproj" />
        <ProjectReference Include="..\Dhcpr.Dns.Core\Dhcpr.Dns.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Dhcpr.Server.UnitTests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="KubernetesClient" Version="19.0.2" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
      <PackageReference Include="Microsoft.Orleans.Clustering.Consul" Version="10.2.2" />
      <PackageReference Include="Microsoft.Orleans.Dashboard" Version="10.2.2" />
      <PackageReference Include="Microsoft.Orleans.Hosting.Kubernetes" Version="10.2.2" />
      <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.2.2" />
      <PackageReference Include="Microsoft.Orleans.Server" Version="10.2.2" />
      <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
      <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.17.0-beta.1" />
      <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
      <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
      <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
      <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
      <PackageReference Include="Orleans.Clustering.Kubernetes" Version="10.0.1" />
    </ItemGroup>

</Project>
